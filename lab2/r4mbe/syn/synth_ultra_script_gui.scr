# for looking at gui with hierarchy
# Variable
set TOP_ENTITY "fpnew_top"
set CLK_NAME "CLK"
set CLK_PIN "clk_i"
set CLK_PERIOD "2.52"
set INPUT_DELAY "0.5"
set OUTPUT_DELAY "0.5"
set JITTER "0.07"
# Remove work directory each run
file delete -force -- work

# Create now directory work
file mkdir work

# Analyze the source files (SVERILOG and VHDL)
analyze -f sverilog -lib work ../src/cvfpu_mbe/cf_math_pkg.sv
analyze -f sverilog -lib work ../src/cvfpu_mbe/lzc.sv
analyze -f sverilog -lib work ../src/cvfpu_mbe/rr_arb_tree.sv
analyze -f sverilog -lib work ../src/cvfpu_mbe/fpnew_pkg.sv
analyze -f sverilog -lib work ../src/cvfpu_mbe/fpnew_classifier.sv
analyze -f sverilog -lib work ../src/cvfpu_mbe/fpnew_rounding.sv
analyze -f sverilog -lib work ../src/cvfpu_mbe/fpnew_fma.sv
analyze -f sverilog -lib work ../src/cvfpu_mbe/fpnew_opgroup_fmt_slice.sv
analyze -f sverilog -lib work ../src/cvfpu_mbe/fpnew_opgroup_block.sv
analyze -f sverilog -lib work ../src/cvfpu_mbe/fpnew_top.sv

# Analyze components for mantissa multiplier
analyze -f sverilog -lib work ../src/half_adder.sv
analyze -f sverilog -lib work ../src/full_adder.sv
analyze -f sverilog -lib work ../src/rca_wt.sv
analyze -f sverilog -lib work ../src/wallace_tree.sv
analyze -f sverilog -lib work ../src/booth_enc_logic.sv
analyze -f sverilog -lib work ../src/MBE.sv
analyze -f sverilog -lib work ../src/mult.sv

# Elaborate design
elaborate $TOP_ENTITY -lib work

# to get rid of multiple instances (should not be our case)
uniquify

# Link step 
link

# Create clock and protect it
create_clock -name $CLK_NAME -period $CLK_PERIOD $CLK_PIN
set_dont_touch_network $CLK_NAME


# setting clock jitter
set_clock_uncertainty $JITTER [get_clock $CLK_NAME]

# set delays of in/out
set_input_delay $INPUT_DELAY -max -clock $CLK_NAME [remove_from_collection [all_inputs] $CLK_PIN]
set_output_delay $OUTPUT_DELAY -max -clock $CLK_NAME [all_outputs]

# set load of each output
set OLOAD [load_of NangateOpenCellLibrary/BUF_X4/A]
set_load $OLOAD [all_outputs]

# Compile
compile_ultra

#re-compile with retiming 
# optimize_registers

# Save data
report_timing > report/timing_r4mbe_ultra_${CLK_PERIOD}ns.txt
report_area > report/area_r4mbe_ultra_${CLK_PERIOD}ns.txt
# generate netlist
ungroup -all -flatten	

# export netlist in verilog
change_names -hierarchy -rules verilog

# save delay of netlist
write_sdf ../netlist/${TOP_ENTITY}_r4mbe_ultra.sdf 

# save netlist in verilog
write -f verilog -hierarchy -output ../netlist/${TOP_ENTITY}_r4mbe_ultra.v

# save constraints of in/out in std format
#write_sdc ../netlist/${TOP_ENTITY}_r4mbe_ultra.sdc

# close design compiler
#quit
